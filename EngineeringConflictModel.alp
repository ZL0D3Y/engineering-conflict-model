			<Events>
				<Event>
					<Id>1789133961943</Id>
					<Name><![CDATA[engineerStateSync]]></Name>
					<Description><![CDATA[Weekly: syncs developer perceived risk, updates ObservedWarningResponseRate, decays ManagerCapacityBoost, tracks PS telemetry, updates debtTrend and allocationEfficiency, writes CSV row.]]></Description>
					<X>1450</X><Y>350</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[WEEK]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_WEEK]]></Unit>
						</Rate>
						<Id>1789133961941</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1789200000000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[0]]></Code>
							<Unit Class="TimeUnits"><![CDATA[WEEK]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[WEEK]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[// Sync PM traits from UI sliders
productManagerAgent.riskTolerance = pmRiskTolerance;
productManagerAgent.deliveryBias   = pmDeliveryBias;

engineerAgent.perceivedRisk = TechnicalRisk;
ObservedWarningResponseRate = getObservedWarningResponseRate();

// Allocated capacity fades ~10% per week without renewal
ManagerCapacityBoost = Math.max(0.0, ManagerCapacityBoost * 0.9);

// Debt trend (updated every 4 weeks)
debtTrendCounter++;
if (debtTrendCounter >= 4) {
    double current = TechnicalDebt;
    if      (current > tdPrev4 + 2.0) { debtTrend = "INCREASING"; }
    else if (current < tdPrev4 - 2.0) { debtTrend = "DECREASING"; }
    else                              { debtTrend = "STABLE";     }
    tdPrev4 = current;
    debtTrendCounter = 0;
}

// Allocation efficiency
if (productManagerAgent.capacityAllocations == 0) {
    allocationEfficiency = "N_A";
} else if (debtTrend.equals("DECREASING")) {
    allocationEfficiency = "POSITIVE";
} else if (debtTrend.equals("INCREASING")) {
    allocationEfficiency = "NEGATIVE";
} else {
    allocationEfficiency = "NEUTRAL";
}]]></Action>
				</Event>
				<Event>
					<Id>1789221702944</Id>
					<Name><![CDATA[engineerDecisionCheck]]></Name>
					<Description><![CDATA[Weekly: evaluates whether to invoke the engineer LLM decision process based on risk level and cooldown.]]></Description>
					<X>1450</X><Y>380</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TriggerType="timeout" Mode="cyclic">
						<Timeout Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[WEEK]]></Unit>
						</Timeout>
						<Rate Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="RateUnits"><![CDATA[PER_WEEK]]></Unit>
						</Rate>
						<Id>1789221702942</Id>
						<OccurrenceAtTime>true</OccurrenceAtTime>
						<OccurrenceDate>1789286400000</OccurrenceDate>
						<OccurrenceTime Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[WEEK]]></Unit>
						</OccurrenceTime>
						<RecurrenceCode Class="CodeUnitValue">
							<Code><![CDATA[1]]></Code>
							<Unit Class="TimeUnits"><![CDATA[WEEK]]></Unit>
						</RecurrenceCode>
						<Condition><![CDATA[false]]></Condition>
					</Properties>
					<Action><![CDATA[if (
    !engineerAgent.aiRequestInProgress
    && shouldEngineerEvaluate(engineerAgent)
) {

    if (engineerAgent.perceivedRisk < 0.20) {
        engineerAgent.lastEvaluatedRiskLevel = "LOW";
    } else if (engineerAgent.perceivedRisk < 0.40) {
        engineerAgent.lastEvaluatedRiskLevel = "MODERATE";
    } else if (engineerAgent.perceivedRisk < 0.70) {
        engineerAgent.lastEvaluatedRiskLevel = "HIGH";
    } else {
        engineerAgent.lastEvaluatedRiskLevel = "CRITICAL";
    }

    engineerAgent.lastDecisionTime =
        time();

    askEngineer(engineerAgent);
}]]></Action>
				</Event>
			</Events>
			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789134496529</Id>
					<Name><![CDATA[askEngineer]]></Name>
					<Description><![CDATA[Invokes the LLM to simulate an engineer organizational decision. Runs asynchronously in a background thread.]]></Description>
					<X>1850</X><Y>240</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[eng]]></Name>
						<Type><![CDATA[EngineerAgent]]></Type>
					</Parameter>
					<Body><![CDATA[if (eng.aiRequestInProgress) {
    return;
}

eng.aiRequestInProgress = true;
eng.aiStatus = "REQUESTING";

final String prompt =
    buildEngineerPrompt(eng);

new Thread(() -> {

    try {

        String response = sendLlmRequest(prompt, "DEVELOPER");

        EngineerDecision decision =
            parseEngineerDecision(response);

        applyEngineerDecision(eng, decision);

        eng.aiStatus = "DONE";

    } catch (Exception e) {

        eng.lastAction = "LLM_ERROR";
        eng.decisionReason = e.toString();

        eng.aiStatus = "ERROR";

    } finally {

        eng.aiRequestInProgress = false;
    }

}).start();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1789143933709</Id>
					<Name><![CDATA[buildEngineerPrompt]]></Name>
					<Description><![CDATA[Constructs the structured LLM prompt for the engineer agent, encoding SD state, developer traits, warning history, debtTrend, and focal point status.]]></Description>
					<X>1850</X><Y>210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[eng]]></Name>
						<Type><![CDATA[EngineerAgent]]></Type>
					</Parameter>
					<Body><![CDATA[String riskLevel;

if (eng.perceivedRisk < 0.20) {
    riskLevel = "LOW";
} else if (eng.perceivedRisk < 0.40) {
    riskLevel = "MODERATE";
} else if (eng.perceivedRisk < 0.70) {
    riskLevel = "HIGH";
} else {
    riskLevel = "CRITICAL";
}


String riskToleranceLevel;

if (eng.riskTolerance < 0.33) {
    riskToleranceLevel = "LOW";
} else if (eng.riskTolerance < 0.67) {
    riskToleranceLevel = "MEDIUM";
} else {
    riskToleranceLevel = "HIGH";
}


String assertivenessLevel;

if (eng.assertiveness < 0.33) {
    assertivenessLevel = "LOW";
} else if (eng.assertiveness < 0.67) {
    assertivenessLevel = "MEDIUM";
} else {
    assertivenessLevel = "HIGH";
}

String psychologicalSafetyLevel;

if (PsychologicalSafety < 0.33) {
    psychologicalSafetyLevel = "LOW";
} else if (PsychologicalSafety < 0.67) {
    psychologicalSafetyLevel = "MEDIUM";
} else {
    psychologicalSafetyLevel = "HIGH";
}


return
    "You simulate a software engineer making an organizational decision.\n\n" +

    "AUTHORITATIVE STATE:\n" +
    "technicalRisk=" + eng.perceivedRisk + "\n" +
    "technicalRiskLevel=" + riskLevel + "\n" +
    "technicalDebt=" + TechnicalDebt + "\n" +
    "deliveryPressure=" + DeliveryPressure + "\n" +
    "errorBudgetActive=" + (ErrorBudgetActive > 0.5 ? "YES" : "NO") + "\n\n" +

"AUTHORITATIVE DEVELOPER TRAITS:\n" +
"seniority=" + eng.seniority + "\n" +
"riskToleranceLevel=" + riskToleranceLevel + "\n" +
"assertivenessLevel=" + assertivenessLevel + "\n" +
"psychologicalSafetyLevel=" + psychologicalSafetyLevel + "\n\n" +

    "HISTORY:\n" +
    "warningsRaised=" + eng.warningsRaised + "\n" +
    "warningsIgnored=" + eng.warningsIgnored + "\n" +
    "consecutiveIgnores=" + eng.consecutiveIgnores + "\n" +
    "warningsResponded=" + eng.warningsResponded + "\n" +
    "debtTrend=" + debtTrend + "\n\n" +

    "IMPORTANT CONSTRAINTS:\n" +
    "- technicalRiskLevel, riskToleranceLevel, and assertivenessLevel are calculated by the simulation and are authoritative.\n" +
    "- Never recalculate, reinterpret, or rename these levels.\n" +
    "- LOW riskTolerance means the engineer tolerates little risk and tends to react earlier.\n" +
    "- HIGH riskTolerance means the engineer accepts more risk before reacting.\n" +
    "- LOW assertiveness means the engineer is reluctant to challenge or escalate.\n" +
    "- HIGH assertiveness means the engineer is more willing to challenge or escalate.\n" +
    "- psychologicalSafetyLevel reflects how safe the engineer feels to raise concerns without negative consequences.\n" +
    "- LOW psychologicalSafety means the engineer fears reprisal for speaking up, regardless of technical risk.\n" +
    "- HIGH psychologicalSafety means the engineer feels safe to raise any concern without fear.\n\n" +

    "BEHAVIORAL PRINCIPLES:\n" +
    "- No single input determines the action.\n" +
    "- Balance technical risk, risk tolerance, assertiveness, and warning history together.\n" +
    "- Higher technical risk increases pressure to speak.\n" +
    "- Lower risk tolerance increases sensitivity to technical risk.\n" +
    "- Higher risk tolerance increases willingness to accept technical risk without speaking.\n" +
    "- Higher assertiveness increases willingness to speak and escalate.\n" +
    "- Lower assertiveness increases reluctance to speak and especially to escalate.\n" +
    "- Previous ignored warnings reduce willingness to repeat the same warning through the same channel.\n" +
    "- consecutiveIgnores counts the current streak of ignored warnings without any response. Higher streaks increase justification for ESCALATE.\n" +
    "- consecutiveIgnores >= 3 combined with HIGH or CRITICAL risk is a strong signal to ESCALATE rather than repeat the same channel.\n" +
    "- Previous ignored warnings should increase willingness to ESCALATE, especially when risk remains HIGH or CRITICAL — escalation reaches a different audience and is not subject to the same channel failure.\n" +
    "- Previous successful responses make the normal warning channel more credible.\n" +
    "- Higher psychological safety increases willingness to raise warnings even at moderate risk.\n" +
    "- Lower psychological safety may suppress speaking up even when technical risk is HIGH or CRITICAL.\n" +
    "- Psychological safety is independent of risk tolerance: an engineer may personally accept risk but still fear the social consequences of speaking up.\n\n" +

    "AVAILABLE ACTIONS:\n" +
    "STAY_SILENT\n" +
    "RAISE_WARNING\n" +
    "ESCALATE\n\n" +

    "ACTION SEMANTICS:\n" +
    "- STAY_SILENT: raise no new concern now.\n" +
    "- RAISE_WARNING: communicate the concern through the normal engineering channel.\n" +
    "- ESCALATE: assert the concern through the same channel with increased formal urgency and weight. This is a stronger, more insistent form of the same warning — not routing to a different authority level. Use when risk is HIGH or CRITICAL and normal warnings have been ignored repeatedly.\n\n" +

    "DECISION REQUIREMENTS:\n" +
    "- Choose exactly one action.\n" +
    "- STAY_SILENT is valid at LOW or MODERATE risk when other factors do not justify speaking.\n" +
    "- STAY_SILENT when technicalRiskLevel is HIGH or CRITICAL requires explicit justification — silence at high risk has compounding long-term consequences.\n" +
    "- debtTrend=INCREASING means the situation is worsening — increased urgency to speak or escalate.\n" +
    "- debtTrend=DECREASING means existing actions are working — STAY_SILENT may be appropriate if recent warnings are being addressed.\n" +
    "- errorBudgetActive=YES means the organization has triggered its pre-agreed stabilization policy — structural response is active; raising awareness warnings remains valuable.\n" +
    "- RAISE_WARNING requires sufficient combined justification.\n" +
    "- ESCALATE requires stronger combined justification than RAISE_WARNING — use it when consecutive warnings have been ignored and risk is HIGH or CRITICAL. It signals formal urgency within the same channel.\n" +
    "- Your reason must be consistent with the authoritative levels and selected action.\n\n" +

    "Return JSON only:\n" +
    "{\"action\":\"<STAY_SILENT|RAISE_WARNING|ESCALATE>\",\"reason\":\"<SHORT_REASON>\"}";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1789144300001</Id>
					<Name><![CDATA[sendOllamaRequest]]></Name>
					<Description><![CDATA[Sends a structured JSON request to the Ollama local LLM API with constrained output schema.]]></Description>
					<X>1950</X><Y>120</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[prompt]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[decisionType]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[try {

    String actionEnum;

    if (decisionType.equals("DEVELOPER")) {

        actionEnum =
            "["
            + "\"STAY_SILENT\","
            + "\"RAISE_WARNING\","
            + "\"ESCALATE\""
            + "]";

    } else if (decisionType.equals("MANAGER")) {
	
	    actionEnum =
	        "["
	        + "\"DEFER\","
	        + "\"ACKNOWLEDGE\","
	        + "\"ALLOCATE_CAPACITY\""
	        + "]";
	
	} else {

        throw new RuntimeException(
            "Unsupported decision type: "
            + decisionType
        );
    }


    java.net.URL url =
        new java.net.URL(llmEndpoint);


    java.net.HttpURLConnection connection =
        (java.net.HttpURLConnection) url.openConnection();


    connection.setRequestMethod("POST");

    connection.setRequestProperty(
        "Content-Type",
        "application/json"
    );

    connection.setConnectTimeout(5000);
    connection.setReadTimeout(60000);

    connection.setDoOutput(true);


    String requestBody =
        "{"

        + "\"model\":"
        + escapeJson(llmModel)
        + ","

        + "\"stream\":false,"

        + "\"think\":false,"

        + "\"format\":{"

            + "\"type\":\"object\","

            + "\"properties\":{"

                + "\"action\":{"
                    + "\"type\":\"string\","
                    + "\"enum\":"
                    + actionEnum
                + "},"

                + "\"reason\":{"
                    + "\"type\":\"string\""
                + "}"

            + "},"

            + "\"required\":["
                + "\"action\","
                + "\"reason\""
            + "]"

        + "},"

        + "\"options\":{"
            + "\"temperature\":0.6,"
            + "\"num_predict\":120"
        + "},"

        + "\"messages\":["
            + "{"
                + "\"role\":\"user\","
                + "\"content\":"
                + escapeJson(prompt)
            + "}"
        + "]"

        + "}";


    try (
        java.io.OutputStream os =
            connection.getOutputStream()
    ) {

        os.write(
            requestBody.getBytes(
                java.nio.charset.StandardCharsets.UTF_8
            )
        );
    }


    int responseCode =
        connection.getResponseCode();


    java.io.InputStream inputStream;

    if (
        responseCode >= 200
        && responseCode < 300
    ) {

        inputStream =
            connection.getInputStream();

    } else {

        inputStream =
            connection.getErrorStream();
    }


    StringBuilder response =
        new StringBuilder();


    if (inputStream != null) {

        try (
            java.io.BufferedReader reader =
                new java.io.BufferedReader(
                    new java.io.InputStreamReader(
                        inputStream,
                        java.nio.charset.StandardCharsets.UTF_8
                    )
                )
        ) {

            String line;

            while (
                (line = reader.readLine()) != null
            ) {
                response.append(line);
            }
        }
    }


    connection.disconnect();


    String rawResponse =
        response.toString();


    if (
        responseCode < 200
        || responseCode >= 300
    ) {

        throw new RuntimeException(
            "Ollama HTTP "
            + responseCode
            + ": "
            + rawResponse
        );
    }


    /*
     * Ollama /api/chat response:
     *
     * {
     *   "message": {
     *     "role": "assistant",
     *     "content":
     *       "{\"action\":\"...\",\"reason\":\"...\"}"
     *   }
     * }
     */


    java.util.regex.Matcher contentMatcher =
        java.util.regex.Pattern
            .compile(
                "\"content\"\\s*:\\s*\"((?:\\\\.|[^\"])*)\""
            )
            .matcher(rawResponse);


    if (!contentMatcher.find()) {

        throw new RuntimeException(
            "Missing message.content in Ollama response: "
            + rawResponse
        );
    }


    String content =
        contentMatcher
            .group(1)
            .replace("\\\"", "\"")
            .replace("\\n", "\n")
            .replace("\\r", "\r")
            .replace("\\t", "\t")
            .replace("\\\\", "\\");


    return content;


} catch (Exception e) {

    throw new RuntimeException(
        "Ollama request failed: "
        + e.getMessage(),
        e
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1789143954737</Id>
					<Name><![CDATA[sendLlmRequest]]></Name>
					<Description><![CDATA[Routes LLM requests to the configured provider (OLLAMA or GEMINI).]]></Description>
					<X>1950</X><Y>90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[prompt]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[decisionType]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (llmProvider.equals("OLLAMA")) {

    return sendOllamaRequest(
        prompt,
        decisionType
    );

} else if (llmProvider.equals("GEMINI")) {

    return sendGeminiRequest(
        prompt,
        decisionType
    );

} else {

    throw new RuntimeException(
        "Unsupported LLM provider: "
        + llmProvider
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[EngineerDecision]]></ReturnType>
					<Id>1789144824687</Id>
					<Name><![CDATA[parseEngineerDecision]]></Name>
					<Description><![CDATA[Parses LLM JSON response into a EngineerDecision object (action + reason) with validation.]]></Description>
					<X>1850</X><Y>270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[json]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[try {

    String action = parseJsonString(json, "action");
    String reason = parseJsonString(json, "reason");

    if (action == null) {
        throw new RuntimeException("Missing action in LLM response: " + json);
    }

    if (reason == null) { reason = ""; }

    if (!action.equals("STAY_SILENT") && !action.equals("RAISE_WARNING") && !action.equals("ESCALATE")) {
        throw new RuntimeException("Invalid developer action: " + action);
    }

    return new EngineerDecision(action, reason);

} catch (Exception e) {
    throw new RuntimeException("Failed to parse EngineerDecision: " + e.getMessage(), e);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789144912425</Id>
					<Name><![CDATA[applyEngineerDecision]]></Name>
					<Description><![CDATA[Applies the engineer LLM decision: updates counters and triggers manager interaction for RAISE_WARNING and ESCALATE.]]></Description>
					<X>1850</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[eng]]></Name>
						<Type><![CDATA[EngineerAgent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[decision]]></Name>
						<Type><![CDATA[EngineerDecision]]></Type>
					</Parameter>
					<Body><![CDATA[eng.lastAction =
    decision.action;

eng.decisionReason =
    decision.reason;

switch (decision.action) {

    case "STAY_SILENT":

        break;


    case "RAISE_WARNING":

        eng.warningsRaised++;
        eng.warningPending = true;

        askManager(
            productManagerAgent,
            eng
        );

        break;


    case "ESCALATE":

        eng.warningsRaised++;
        eng.warningPending = true;

        askManager(
            productManagerAgent,
            eng
        );

        break;


    default:

        throw new RuntimeException(
            "Unsupported DeveloperAction: "
            + decision.action
        );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1789145808950</Id>
					<Name><![CDATA[sendGeminiRequest]]></Name>
					<Description><![CDATA[Sends a structured JSON request to the Google Gemini API with constrained output schema.]]></Description>
					<X>2090</X><Y>90</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[prompt]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[decisionType]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[try {

    String apiKey = geminiApiKey != null && !geminiApiKey.trim().isEmpty()
        ? geminiApiKey.trim()
        : System.getenv("GEMINI_API_KEY");

    if (apiKey == null || apiKey.trim().isEmpty()) {
        throw new RuntimeException(
            "Gemini API key not set. Set geminiApiKey variable or GEMINI_API_KEY environment variable."
        );
    }


    String actionEnum;

    if (decisionType.equals("DEVELOPER")) {

        actionEnum =
            "["
            + "\"STAY_SILENT\","
            + "\"RAISE_WARNING\","
            + "\"ESCALATE\""
            + "]";

    } else if (decisionType.equals("MANAGER")) {

        actionEnum =
		    "["
		    + "\"DEFER\","
		    + "\"ACKNOWLEDGE\","
		    + "\"ALLOCATE_CAPACITY\""
		    + "]";

    } else {

        throw new RuntimeException(
            "Unsupported decision type: "
            + decisionType
        );
    }


    String endpoint =
        "https://generativelanguage.googleapis.com/v1beta/models/"
        + llmModel
        + ":generateContent";


    java.net.URL url =
        new java.net.URL(endpoint);

    java.net.HttpURLConnection connection =
        (java.net.HttpURLConnection) url.openConnection();


    connection.setRequestMethod("POST");

    connection.setRequestProperty(
        "Content-Type",
        "application/json"
    );

    connection.setRequestProperty(
        "x-goog-api-key",
        apiKey
    );

    connection.setConnectTimeout(10000);
    connection.setReadTimeout(60000);

    connection.setDoOutput(true);


    String requestBody =
        "{"

        + "\"contents\":["
            + "{"
                + "\"role\":\"user\","
                + "\"parts\":["
                    + "{"
                        + "\"text\":"
                        + escapeJson(prompt)
                    + "}"
                + "]"
            + "}"
        + "],"

        + "\"generationConfig\":{"

            + "\"temperature\":0.6,"
            + "\"maxOutputTokens\":256,"

            + "\"responseMimeType\":\"application/json\","

            + "\"responseSchema\":{"

                + "\"type\":\"OBJECT\","

                + "\"properties\":{"

                    + "\"action\":{"
                        + "\"type\":\"STRING\","
                        + "\"enum\":"
                        + actionEnum
                    + "},"

                    + "\"reason\":{"
                        + "\"type\":\"STRING\""
                    + "}"

                + "},"

                + "\"required\":["
                    + "\"action\","
                    + "\"reason\""
                + "]"

            + "}"

        + "}"

        + "}";


    try (
        java.io.OutputStream os =
            connection.getOutputStream()
    ) {

        os.write(
            requestBody.getBytes(
                java.nio.charset.StandardCharsets.UTF_8
            )
        );
    }


    int responseCode =
        connection.getResponseCode();


    java.io.InputStream inputStream;

    if (
        responseCode >= 200
        && responseCode < 300
    ) {

        inputStream =
            connection.getInputStream();

    } else {

        inputStream =
            connection.getErrorStream();
    }


    StringBuilder response =
        new StringBuilder();


    if (inputStream != null) {

        try (
            java.io.BufferedReader reader =
                new java.io.BufferedReader(
                    new java.io.InputStreamReader(
                        inputStream,
                        java.nio.charset.StandardCharsets.UTF_8
                    )
                )
        ) {

            String line;

            while (
                (line = reader.readLine()) != null
            ) {
                response.append(line);
            }
        }
    }


    connection.disconnect();


    String rawResponse =
        response.toString();


    if (
        responseCode < 200
        || responseCode >= 300
    ) {

        throw new RuntimeException(
            "Gemini HTTP "
            + responseCode
            + ": "
            + rawResponse
        );
    }


    /*
     * Gemini response:
     *
     * candidates[0]
     *   .content
     *   .parts[0]
     *   .text
     *
     * text contains our JSON decision.
     */

    java.util.regex.Matcher textMatcher =
        java.util.regex.Pattern
            .compile(
                "\"text\"\\s*:\\s*\"((?:\\\\.|[^\"])*)\""
            )
            .matcher(rawResponse);


    if (!textMatcher.find()) {

        throw new RuntimeException(
            "Missing candidate text in Gemini response: "
            + rawResponse
        );
    }


    String content =
        textMatcher
            .group(1)
            .replace("\\\"", "\"")
            .replace("\\n", "\n")
            .replace("\\r", "\r")
            .replace("\\t", "\t")
            .replace("\\\\", "\\");


    return content;


} catch (Exception e) {

    throw new RuntimeException(
        "Gemini request failed: "
        + e.getMessage(),
        e
    );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1789221618441</Id>
					<Name><![CDATA[shouldEngineerEvaluate]]></Name>
					<Description><![CDATA[Gate function: determines whether the engineer LLM should be invoked this week based on risk level, cooldown, and ignored warning streak.]]></Description>
					<X>2050</X><Y>240</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[eng]]></Name>
						<Type><![CDATA[EngineerAgent]]></Type>
					</Parameter>
					<Body><![CDATA[if (eng.warningPending) {
    return false;
}

String currentRiskLevel;

if (eng.perceivedRisk < 0.20) {
    currentRiskLevel = "LOW";
} else if (eng.perceivedRisk < 0.40) {
    currentRiskLevel = "MODERATE";
} else if (eng.perceivedRisk < 0.70) {
    currentRiskLevel = "HIGH";
} else {
    currentRiskLevel = "CRITICAL";
}


// Не викликаємо LLM, поки ризик LOW
boolean meaningfulRisk =
    !currentRiskLevel.equals("LOW");

if (!meaningfulRisk) {
    return false;
}


boolean firstDecision =
    eng.lastDecisionTime < 0;


boolean levelChanged =
    !currentRiskLevel.equals(
        eng.lastEvaluatedRiskLevel
    );


// Чи минув cooldown після останнього рішення
boolean cooldownPassed =
    firstDecision
    || (
        time() - eng.lastDecisionTime
        >= engineerDecisionCooldown
    );

// Якщо попередження щойно проігноровано — скоротити cooldown вдвічі
// щоб дати шанс переоцінити через ESCALATE
boolean recentlyIgnored =
    eng.warningsIgnored > 0
    && (
        time() - eng.lastDecisionTime
        >= engineerDecisionCooldown / 2.0
    );


return
    firstDecision
    || levelChanged
    || cooldownPassed
    || recentlyIgnored;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1789223602557</Id>
					<Name><![CDATA[buildManagerPrompt]]></Name>
					<Description><![CDATA[Constructs the structured LLM prompt for the manager agent, encoding SD state, manager traits, developer warning context, delivery pressure level, and focal point activation.]]></Description>
					<X>1470</X><Y>210</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[manager]]></Name>
						<Type><![CDATA[ProductManagerAgent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[eng]]></Name>
						<Type><![CDATA[EngineerAgent]]></Type>
					</Parameter>
					<Body><![CDATA[String riskLevel;

if (eng.perceivedRisk < 0.20) {
    riskLevel = "LOW";
} else if (eng.perceivedRisk < 0.40) {
    riskLevel = "MODERATE";
} else if (eng.perceivedRisk < 0.70) {
    riskLevel = "HIGH";
} else {
    riskLevel = "CRITICAL";
}


String managerRiskToleranceLevel;

if (manager.riskTolerance < 0.33) {
    managerRiskToleranceLevel = "LOW";
} else if (manager.riskTolerance < 0.67) {
    managerRiskToleranceLevel = "MEDIUM";
} else {
    managerRiskToleranceLevel = "HIGH";
}


String deliveryBiasLevel;

if (manager.deliveryBias < 0.33) {
    deliveryBiasLevel = "LOW";
} else if (manager.deliveryBias < 0.67) {
    deliveryBiasLevel = "MEDIUM";
} else {
    deliveryBiasLevel = "HIGH";
}

String deliveryPressureLevel;

if (DeliveryPressure < 0.30) {
    deliveryPressureLevel = "LOW";
} else if (DeliveryPressure < 0.70) {
    deliveryPressureLevel = "MEDIUM";
} else {
    deliveryPressureLevel = "HIGH";
}


return
    "You simulate a product manager responding to a technical concern raised by a software engineer.\n\n" +

    "You are making a product prioritization decision — whether to protect feature delivery or invest in technical stability.\n\n" +

    "PRODUCT & ENGINEERING CONTEXT:\n" +
    "technicalRiskLevel=" + riskLevel + "\n" +
    "technicalDebt=" + TechnicalDebt + "\n" +
    "deliveryPressure=" + DeliveryPressure + "\n" +
    "deliveryPressureLevel=" + deliveryPressureLevel + "\n" +
    "debtTrend=" + debtTrend + "\n" +
    "autonomyBoundaryClarity=" + AutonomyBoundaryClarity + "\n" +
    "committedStabilizationBudget=" + CommittedStabilizationBudget + "\n" +
    "errorBudgetActive=" + (ErrorBudgetActive > 0.5 ? "YES" : "NO") + "\n\n" +

    "ENGINEERING SIGNAL:\n" +
    "engineerSeniority=" + eng.seniority + "\n" +
    "engineerWarningsRaised=" + eng.warningsRaised + "\n" +
    "engineerWarningsIgnored=" + eng.warningsIgnored + "\n" +
    "engineerWarningsResponded=" + eng.warningsResponded + "\n" +
    "engineerAction=" + eng.lastAction + "\n\n" +

    "MANAGER HISTORY:\n" +
    "previousCapacityAllocations=" + manager.capacityAllocations + "\n" +
    "allocationEfficiency=" + allocationEfficiency + "\n\n" +

    "AUTHORITATIVE PM TRAITS:\n" +
    "riskToleranceLevel=" + managerRiskToleranceLevel + "\n" +
    "deliveryBiasLevel=" + deliveryBiasLevel + "\n\n" +

    "IMPORTANT CONSTRAINTS:\n" +
    "- technicalRiskLevel, riskToleranceLevel, and deliveryBiasLevel are calculated by the simulation and are authoritative.\n" +
    "- Never recalculate, reinterpret, or rename these levels.\n" +
    "- LOW riskTolerance means the PM acts on engineering concerns early — technical stability is a product priority.\n" +
    "- HIGH riskTolerance means the PM expects the team to ship features despite technical debt.\n" +
    "- LOW deliveryBias means the PM is willing to slow feature delivery to reduce technical risk.\n" +
    "- HIGH deliveryBias means the PM defaults to features and expects engineering to manage technical debt internally.\n\n" +

    "BEHAVIORAL PRINCIPLES:\n" +
    "- No single input determines the action.\n" +
    "- committedStabilizationBudget > 0 means a structural capacity commitment is already in place — ALLOCATE_CAPACITY is less urgent since stabilization is happening structurally.\n" +
    "- errorBudgetActive=YES means TechnicalRisk has exceeded the pre-agreed threshold — organizational policy requires stabilization; DEFER is inappropriate.\n" +
    "- Balance technical risk, delivery pressure, PM traits, engineer seniority, and warning history.\n" +
    "- Higher technical risk increases justification for dedicating sprint capacity to stabilization.\n" +
    "- Lower PM risk tolerance increases willingness to act on engineering concerns.\n" +
    "- Higher PM risk tolerance means the PM believes the team can ship features despite technical debt.\n" +
    "- Higher delivery bias means the PM keeps the team on features unless risk is critical.\n" +
    "- Lower delivery bias means the PM is willing to trade feature velocity for technical stability.\n" +
    "- Repeated previously deferred warnings may increase the significance of the current warning.\n" +
    "- Previous responses may provide evidence that the concern is persistent or unresolved.\n" +
    "- Developer seniority may affect how much weight the manager gives the warning, but seniority alone must not determine the action.\n" +
    "- When deliveryPressureLevel is HIGH, DEFER is an appropriate response even to legitimate warnings — capacity is already constrained.\n" +
    "- When deliveryPressureLevel is MEDIUM and debtTrend is STABLE or DECREASING, DEFER is a reasonable choice even for MEDIUM risk tolerance.\n" +
    "- allocationEfficiency=NEGATIVE means repeated allocations have not reduced debt — further ALLOCATE_CAPACITY may not help; DEFER signals a different approach is needed.\n" +
    "- allocationEfficiency=POSITIVE means existing allocations are working — DEFER is appropriate to let them take effect before allocating more.\n" +
    "- debtTrend=DECREASING combined with previous allocations justifies DEFER — the system is already improving.\n" +
    "- debtTrend=INCREASING despite allocations (allocationEfficiency=NEGATIVE) suggests ACKNOWLEDGE with a note that the approach needs to change.\n" +
    "- Repeated ALLOCATE_CAPACITY (see previousCapacityAllocations) without observable risk reduction suggests structural debt requiring a different approach, not just more capacity — consider ACKNOWLEDGE or DEFER to signal this.\n" +
    "- MEDIUM riskTolerance and MEDIUM deliveryBias should produce a mix of DEFER, ACKNOWLEDGE, and ALLOCATE_CAPACITY across different contexts — consistently choosing only one action is likely a calibration error.\n" +
    "- autonomyBoundaryClarity reflects how clearly technical implementation decisions are owned by engineering. Low clarity means the manager may push implementation shortcuts directly — which accelerates debt accumulation regardless of warnings.\n\n" +

    "AVAILABLE ACTIONS:\n" +
    "DEFER\n" +
    "ACKNOWLEDGE\n" +
    "ALLOCATE_CAPACITY\n\n" +

    "ACTION SEMANTICS:\n" +
    "- DEFER: continue prioritizing feature delivery. The concern is noted but current product commitments take precedence. Appropriate when deliveryPressureLevel is HIGH or debtTrend is DECREASING.\n" +
    "- ACKNOWLEDGE: formally add the concern to the product backlog. No sprint capacity diverted now, but the issue is explicitly tracked and will be revisited.\n" +
    "- ALLOCATE_CAPACITY: dedicate sprint capacity to technical stabilization. Feature delivery is deprioritized this cycle to address the engineering concern.\n\n" +

    "DECISION REQUIREMENTS:\n" +
    "- Choose exactly one action.\n" +
    "- DEFER is a valid product decision — feature delivery is a legitimate priority.\n" +
    "- ACKNOWLEDGE is stronger than DEFER — it formally commits the concern to the product backlog.\n" +
    "- ALLOCATE_CAPACITY is the strongest response — it directly trades feature velocity for technical stability.\n" +
    "- Choose based on the combined context, not on a single factor.\n" +
    "- Your reason must be consistent with the authoritative levels and selected action.\n\n" +

    "Return JSON only:\n" +
    "{\"action\":\"<DEFER|ACKNOWLEDGE|ALLOCATE_CAPACITY>\",\"reason\":\"<SHORT_REASON>\"}";]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[ManagerDecision]]></ReturnType>
					<Id>1789223672075</Id>
					<Name><![CDATA[parseManagerDecision]]></Name>
					<Description><![CDATA[Parses LLM JSON response into a ManagerDecision object (action + reason) with validation.]]></Description>
					<X>1470</X><Y>240</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[json]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[try {

    String action = parseJsonString(json, "action");
    String reason = parseJsonString(json, "reason");

    if (action == null) {
        throw new RuntimeException("Missing action in Manager LLM response: " + json);
    }

    if (reason == null) { reason = ""; }

    if (!action.equals("DEFER") && !action.equals("ACKNOWLEDGE") && !action.equals("ALLOCATE_CAPACITY")) {
        throw new RuntimeException("Unsupported Manager action: " + action);
    }

    return new ManagerDecision(action, reason);

} catch (Exception e) {
    throw new RuntimeException("Failed to parse ManagerDecision: " + e.getMessage(), e);
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789223733533</Id>
					<Name><![CDATA[applyManagerDecision]]></Name>
					<Description><![CDATA[Applies the manager LLM decision: updates response counters, scoring, consecutive ignore tracking, and ManagerCapacityBoost.]]></Description>
					<X>1470</X><Y>270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[manager]]></Name>
						<Type><![CDATA[ProductManagerAgent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[eng]]></Name>
						<Type><![CDATA[EngineerAgent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[decision]]></Name>
						<Type><![CDATA[ManagerDecision]]></Type>
					</Parameter>
					<Body><![CDATA[manager.lastAction =
    decision.action;

manager.decisionReason =
    decision.reason;

boolean isEscalation =
    eng.lastAction.equals("ESCALATE");

switch (decision.action) {

    case "DEFER":

        eng.warningsIgnored++;
        eng.consecutiveIgnores++;

        eng.warningPending =
            false;

        manager.resolvedWarnings++;

        // Escalation DEFERRED still registers as a partial signal
        manager.responseScoreSum +=
            isEscalation ? 0.1 : 0.0;

        break;


    case "ACKNOWLEDGE":

        eng.warningsResponded++;
        eng.consecutiveIgnores = 0;

        eng.warningPending =
            false;

        manager.resolvedWarnings++;

        // Escalation ACKNOWLEDGED carries stronger organizational weight
        manager.responseScoreSum +=
            isEscalation ? 0.75 : 0.5;

        break;


    case "ALLOCATE_CAPACITY":

        eng.warningsResponded++;
        eng.consecutiveIgnores = 0;

        eng.warningPending =
            false;

        manager.capacityAllocations++;

        manager.resolvedWarnings++;

        manager.responseScoreSum +=
            1.0;

        // Escalation triggers a larger capacity commitment
        ManagerCapacityBoost =
            Math.min(
                0.20,
                ManagerCapacityBoost + (isEscalation ? 0.10 : 0.05)
            );

        break;


    default:

        throw new RuntimeException(
            "Unsupported ManagerAction: "
            + decision.action
        );
}]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789223823347</Id>
					<Name><![CDATA[askManager]]></Name>
					<Description><![CDATA[Invokes the LLM to simulate a manager response to an engineer warning. Runs asynchronously in a background thread.]]></Description>
					<X>1470</X><Y>300</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[manager]]></Name>
						<Type><![CDATA[ProductManagerAgent]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[eng]]></Name>
						<Type><![CDATA[EngineerAgent]]></Type>
					</Parameter>
					<Body><![CDATA[if (manager.aiRequestInProgress) {
    return;
}

manager.aiRequestInProgress = true;
manager.aiStatus = "REQUESTING";
manager.warningsReceived++;

new Thread(() -> {

    try {

        String prompt =
            buildManagerPrompt(
                manager,
                eng
            );

        String response = sendLlmRequest(prompt, "MANAGER");

        ManagerDecision decision =
            parseManagerDecision(response);

        applyManagerDecision(manager, eng, decision);

        manager.aiStatus = "DONE";

    } catch (Exception e) {

        manager.aiStatus = "ERROR";
        manager.decisionReason = e.getMessage();
        manager.failedRequests++;

        /*
         * Infrastructure failure — do not skew
         * ObservedWarningResponseRate. Clear warningPending
         * so the engineer can re-evaluate on the next cycle.
         */
        eng.warningPending = false;
        eng.lastAction = "MANAGER_UNAVAILABLE";
        eng.decisionReason =
            "Manager LLM request failed: " + e.getMessage();

    } finally {

        manager.aiRequestInProgress = false;
    }

}).start();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1789225752257</Id>
					<Name><![CDATA[getObservedWarningResponseRate]]></Name>
					<Description><![CDATA[Computes observed warning response rate from manager history. Returns 0.5 (neutral) before any resolved warnings.]]></Description>
					<X>2050</X><Y>270</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[if (
    productManagerAgent.resolvedWarnings == 0
) {
    return 0.5;
}

return
    productManagerAgent.responseScoreSum
    / productManagerAgent.resolvedWarnings;]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1789300000001</Id>
					<Name><![CDATA[escapeJson]]></Name>
					<Description><![CDATA[Safely escapes a string for inclusion in a JSON value, handling quotes, backslashes, and control characters.]]></Description>
					<X>1950</X><Y>30</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[s]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[if (s == null) {
    return "\"\"";
}

StringBuilder sb = new StringBuilder("\"");

for (int i = 0; i < s.length(); i++) {

    char c = s.charAt(i);

    if      (c == '"')  { sb.append("\\\""); }
    else if (c == '\\') { sb.append("\\\\"); }
    else if (c == '\n') { sb.append("\\n");  }
    else if (c == '\r') { sb.append("\\r");  }
    else if (c == '\t') { sb.append("\\t");  }
    else if (c < 0x20)  { sb.append(String.format("\\u%04x", (int) c)); }
    else                { sb.append(c); }
}

sb.append('"');

return sb.toString();]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[String]]></ReturnType>
					<Id>1789300000002</Id>
					<Name><![CDATA[parseJsonString]]></Name>
					<Description><![CDATA[Extracts a JSON string field value by key name using a state-machine parser that handles standard escape sequences.]]></Description>
					<X>1950</X><Y>60</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>false</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[json]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[key]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[String searchKey = "\"" + key + "\"";

int keyIdx = json.indexOf(searchKey);
if (keyIdx < 0) { return null; }

int colonIdx = json.indexOf(':', keyIdx + searchKey.length());
if (colonIdx < 0) { return null; }

int valueStart = colonIdx + 1;
while (valueStart < json.length() && Character.isWhitespace(json.charAt(valueStart))) {
    valueStart++;
}
if (valueStart >= json.length() || json.charAt(valueStart) != '"') {
    return null;
}

StringBuilder sb = new StringBuilder();
int i = valueStart + 1;

while (i < json.length()) {
    char c = json.charAt(i);
    if (c == '\\') {
        i++;
        if (i >= json.length()) { break; }
        char esc = json.charAt(i);
        switch (esc) {
            case '"':  sb.append('"');  break;
            case '\\': sb.append('\\'); break;
            case 'n':  sb.append('\n'); break;
            case 'r':  sb.append('\r'); break;
            case 't':  sb.append('\t'); break;
            default:   sb.append(esc);  break;
        }
    } else if (c == '"') {
        break;
    } else {
        sb.append(c);
    }
    i++;
}

return sb.toString();]]></Body>
