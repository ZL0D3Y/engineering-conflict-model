				<Variable Class="Flow">
					<Id>1788204458517</Id>
					<Name><![CDATA[DebtRepayment]]></Name>
					<Description><![CDATA[Rate of technical debt reduction. Combines passive capacity, CommittedStabilizationBudget (focal point 1), ErrorBudgetActive (focal point 2), and ManagerCapacityBoost.]]></Description>
					<X>830</X><Y>1670</Y>
					<Label><X>0</X><Y>-20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties SourceId="1788204302414" External="false" Constant="false" Array="false">
						<Formula><![CDATA[TechnicalDebt * Math.min(
    1.0,
    StabilizationCapacity
    + CommittedStabilizationBudget
    + ErrorBudgetActive * 0.15
    + ManagerCapacityBoost
)
* 0.1
+ ResponseDrivenRepayment]]></Formula>
						<Color>-4073239</Color>
						<ValveIndex>1</ValveIndex>
						<Points>
							<Point><X>0</X><Y>0</Y></Point>
							<Point><X>100</X><Y>0</Y></Point>
							<Point><X>200</X><Y>0</Y></Point>
						</Points>
					</Properties>
