					<Properties External="false" Constant="false" Array="false">
						<Formula><![CDATA[10]]></Formula>
						<Value><![CDATA[0]]></Value>
						<Color>-4073239</Color>
					</Properties>

				</Variable>
				<Variable Class="AuxVariable">
					<Id>1788284391467</Id>
					<Name><![CDATA[ShortTermBoost]]></Name>
					<Description><![CDATA[Temporary delivery multiplier under pressure. Formula: 1 + DeliveryPressure × 0.5. Provides short-term relief at the cost of accelerating debt.]]></Description>
					<X>440</X><Y>1420</Y>
					<Label><X>0</X><Y>-20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties External="false" Constant="false" Array="false">
						<Formula><![CDATA[1 + DeliveryPressure * 0.5]]></Formula>
						<Value><![CDATA[0]]></Value>
						<Color>-4073239</Color>
					</Properties>

				</Variable>
				<Variable Class="AuxVariable">
					<Id>1788966532646</Id>
					<Name><![CDATA[TechnicalRisk]]></Name>
					<Description><![CDATA[Nonlinear risk index. Formula: TechnicalDebt / (TechnicalDebt + 100). Approaches 1.0 asymptotically — captures diminishing returns of debt growth on risk perception.]]></Description>
					<X>1050</X><Y>1820</Y>
					<Label><X>0</X><Y>-20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties External="false" Constant="false" Array="false">
						<Formula><![CDATA[TechnicalDebt / (TechnicalDebt + RiskScale)]]></Formula>
