				<Variable Class="AuxVariable">
					<Id>1788204556555</Id>
					<Name><![CDATA[DeliveryPressure]]></Name>
					<Description><![CDATA[Normalized gap between expected and actual delivery (0–1). Primary driver of short-term boost and debt accumulation.]]></Description>
					<X>820</X><Y>1490</Y>
					<Label><X>0</X><Y>-20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties External="false" Constant="false" Array="false">
						<Formula><![CDATA[max(0, min(1, DeliveryGap / ExpectedDeliveryRate))]]></Formula>
						<Value><![CDATA[0]]></Value>
						<Color>-65536</Color>
					</Properties>

				</Variable>
				<Variable Class="AuxVariable">
					<Id>1788204803829</Id>
					<Name><![CDATA[CostOfChange]]></Name>
					<Description><![CDATA[Delivery cost multiplier due to technical debt. Formula: 1 + (TechnicalDebt/100)². Quadratic — small debt has little effect, large debt is severely penalizing.]]></Description>
					<X>790</X><Y>1800</Y>
					<Label><X>0</X><Y>-20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties External="false" Constant="false" Array="false">
						<Formula><![CDATA[1 + pow(TechnicalDebt / 100, 2)]]></Formula>
						<Value><![CDATA[0]]></Value>
						<Color>-256</Color>
					</Properties>

				</Variable>
				<Variable Class="AuxVariable">
					<Id>1788205402935</Id>
					<Name><![CDATA[ActualDeliveryRate]]></Name>
					<Description><![CDATA[Effective delivery rate after accounting for CostOfChange penalty and ShortTermBoost.]]></Description>
					<X>520</X><Y>1810</Y>
					<Label><X>0</X><Y>-20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties External="false" Constant="false" Array="false">
						<Formula><![CDATA[BaseDeliveryRate * ShortTermBoost / CostOfChange]]></Formula>
						<Value><![CDATA[0]]></Value>
						<Color>-4073239</Color>
					</Properties>

				</Variable>
				<Variable Class="AuxVariable">
					<Id>1788205432746</Id>
					<Name><![CDATA[DeliveryGap]]></Name>
					<Description><![CDATA[Absolute gap between expected and actual delivery. Input to DeliveryPressure.]]></Description>
					<X>590</X><Y>1600</Y>
					<Label><X>0</X><Y>-20</Y></Label>
