				<Variable Class="Flow">
					<Id>1788204357961</Id>
					<Name><![CDATA[DebtAccumulation]]></Name>
					<Description><![CDATA[Rate of technical debt accumulation. Baseline + delivery pressure component + autonomy boundary violation effect.]]></Description>
					<X>620</X><Y>1670</Y>
					<Label><X>0</X><Y>-20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Properties TargetId="1788204302414" External="false" Constant="false" Array="false">
						<Formula><![CDATA[1 + 4 * DeliveryPressure + (1 - AutonomyBoundaryClarity) * productManagerAgent.deliveryBias * 1.5]]></Formula>
						<Color>-4073239</Color>
						<ValveIndex>1</ValveIndex>
						<Points>
							<Point><X>0</X><Y>0</Y></Point>
